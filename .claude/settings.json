{
  "permissions": {
    "allow": [
      "Bash(node_modules/.bin/open-slide dev *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:5176)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch-name.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-doc-update.sh"
          }
        ]
      }
    ]
  }
}
